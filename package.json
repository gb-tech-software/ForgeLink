{
  "name": "forgelink",
  "version": "1.0.0",
  "description": "A mobile IDE for development on Android",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "android:build": "cd android && ./gradlew assembleDebug",
    "android:release": "cd android && ./gradlew assembleRelease",
    "android:install": "cd android && ./gradlew installDebug",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "test": "node src/workspace.test.js && node src/projectDetection.test.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^1.2.0",
    "react": "18.3.1",
    "react-native": "0.76.0",
    "react-native-gesture-handler": "^2.2.0",
    "react-native-reanimated": "^3.16.0",
    "react-native-webview": "^13.2.0"
  },
  "devDependencies": {
    "@react-native-community/cli": "^20.2.0",
    "@react-native/metro-config": "^0.76.0",
    "@babel/core": "^7.24.0",
    "@types/react": "^18.3.15",
    "@types/react-native": "^0.73.0",
    "react-native-codegen": "^0.71.0",
    "typescript": "^5.5.4"
  }
}
